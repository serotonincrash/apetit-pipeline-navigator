# Copy to infra/.env (Compose) or the worktree's backend/.env (local runs) and fill in.

# Which services `docker compose up` starts: dev = Postgres and SeaweedFS only, app = everything.
COMPOSE_PROFILES=dev

# opencode, gemini or fake. Fake needs no key and returns fixed answers.
LLM_MODE=fake
# An OpenCode Go key (oc_sk_...) and a Go model id, such as glm-5.3.
OPENCODE_API_KEY=
OPENCODE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

POSTGRES_PASSWORD=navigator
DATABASE_URL=postgresql+psycopg://navigator:navigator@localhost:5432/navigator

S3_ACCESS_KEY=navigator
S3_SECRET_KEY=navigator-dev
S3_ENDPOINT=localhost:8333
S3_BUCKET=navigator
S3_SEED_BUCKET=navigator-seed

# The unzipped challenge package, on the machine running Compose or the seed job.
PACKAGE_DIR=../APETIT_CLIMATE_NATURE_NAVIGATOR_2026

# Vultr VM only.
DOMAIN=
BASIC_AUTH_USER=
# Make with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the password'
BASIC_AUTH_HASH=

LOG_LEVEL=INFO
